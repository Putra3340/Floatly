<Window
    x:Class="Floatly.Views.Windows.FloatingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Floatly.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Floatly.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="FloatingWindow"
    Width="640"
    Height="360"
    d:DataContext="{d:DesignInstance local:FloatingWindow,
                                     IsDesignTimeCreatable=False}"
    AllowsTransparency="True"
    Background="Transparent"
    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Activated">
            <i:InvokeCommandAction Command="{Binding ViewModel.WindowFocusCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Deactivated">
            <i:InvokeCommandAction Command="{Binding ViewModel.WindowLostFocusCommand}" />
        </i:EventTrigger>

    </i:Interaction.Triggers>
    <Grid RowDefinitions="360">
        <Grid>
            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{Binding ViewModel.Thumbnail}" Stretch="UniformToFill" />
                </Rectangle.Fill>
            </Rectangle>
            <ContentControl x:Name="PlayerHost" />
            <Border
                Margin="0,0,0,20"
                Padding="6,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="Black"
                CornerRadius="6"
                IsHitTestVisible="False">
                <ui:TextBlock
                    Background="Black"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding ViewModel.ActiveLyric}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Border>
            <controls:SlideMenu
                Width="210"
                Height="260"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsOpen="{Binding ViewModel.IsMenuOpen}"
                ItemsSource="{Binding ViewModel.MenuItems}"
                MenuWidth="210" />
            <Border
                Height="90"
                Padding="20"
                VerticalAlignment="Bottom"
                Background="#88000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding ViewModel.ControlVisibility}">

                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">

                    <!--  Previous  -->
                    <ui:Button
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Appearance="Transparent"
                        Command="{Binding ViewModel.Rewind10SecondsCommand}"
                        Icon="{ui:SymbolIcon Symbol=SkipBack1024}" />

                    <!--  Play / Pause  -->
                    <ui:Button
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Command="{Binding ViewModel.PlayPauseCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="{Binding ViewModel.PlayPauseIcon}" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!--  Next  -->
                    <ui:Button
                        Grid.Column="2"
                        Margin="0,0,20,0"
                        Appearance="Transparent"
                        Command="{Binding ViewModel.Skip10SecondsCommand}"
                        Icon="{ui:SymbolIcon Symbol=SkipForward1024}" />

                    <!--  Progress  -->
                    <Grid
                        Grid.Column="3"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        RowDefinitions="Auto,Auto">

                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="{Binding ViewModel.ProgressText}" />

                            <Slider
                                x:Name="ProgressSlider"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                Maximum="{Binding ViewModel.Duration}"
                                Minimum="0"
                                PreviewMouseUp="Slider_PreviewMouseUp"
                                Value="{Binding ViewModel.Progress, Mode=OneWay}" />

                            <TextBlock
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="{Binding ViewModel.DurationText}" />

                        </Grid>

                    </Grid>

                    <!--  Volume  -->
                    <ui:Button
                        Grid.Column="4"
                        Margin="0,0,8,0"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon Speaker224}" />
                    <ui:Button
                        Grid.Column="5"
                        Command="{Binding ViewModel.LoadCaptionsCommand}"
                        Icon="{ui:SymbolIcon Symbol=ClosedCaption24}" />

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
