<ui:FluentWindow
    x:Class="Floatly.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Floatly.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1100"
    Height="650"
    d:DataContext="{d:DesignInstance local:MainWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Padding="42,0,42,0"
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            FooterMenuItemsSource="{Binding ViewModel.FooterMenuItems, Mode=OneWay}"
            FrameMargin="0"
            IsBackButtonVisible="Visible"
            IsPaneToggleVisible="True"
            MenuItemsSource="{Binding ViewModel.MenuItems, Mode=OneWay}"
            PaneDisplayMode="LeftFluent">
            <ui:NavigationView.Header>
                <ui:BreadcrumbBar x:Name="BreadcrumbBar" Margin="42,32,42,20" />
            </ui:NavigationView.Header>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        <ContentPresenter
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="2" />
        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ViewModel.ApplicationTitle}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Border
            Grid.Row="2"
            Height="90"
            Margin="8"
            Padding="12"
            BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Cover  -->
                <Border
                    Width="58"
                    Height="58"
                    ClipToBounds="True"
                    CornerRadius="12">

                    <Image Source="{Binding ViewModel.CurrentSong.ThumbnailUrl}" Stretch="UniformToFill" />
                </Border>

                <!--  Song Info  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0"
                    VerticalAlignment="Center">

                    <ui:TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{Binding ViewModel.CurrentSong.Name}" />

                    <ui:TextBlock
                        Margin="0,4,0,0"
                        Opacity="0.7"
                        Text="{Binding ViewModel.CurrentSong.Uploader}" />

                    <!--  Progress  -->
                    <Slider
                        Margin="0,10,0,0"
                        Maximum="{Binding ViewModel.CurrentSong.DurationValue}"
                        Value="0" />
                </StackPanel>

                <!--  Controls  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <ui:Button
                        Margin="4"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon Symbol=SkipBack1024}" />

                    <ui:Button
                        Margin="4"
                        Appearance="Primary"
                        Icon="{ui:SymbolIcon Play24}" />

                    <ui:Button
                        Margin="4"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon Symbol=SkipForward1024}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
