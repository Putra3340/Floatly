<ui:FluentWindow
    x:Class="Floatly.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Floatly.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Floatly.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1100"
    Height="650"
    d:DataContext="{d:DesignInstance local:MainWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <i:Interaction.Triggers>

        <i:EventTrigger EventName="Activated">
            <i:InvokeCommandAction Command="{Binding ViewModel.WindowFocusCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Deactivated">
            <i:InvokeCommandAction Command="{Binding ViewModel.WindowLostFocusCommand}" />
        </i:EventTrigger>

    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Padding="42,0,42,0"
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            FooterMenuItemsSource="{Binding ViewModel.FooterMenuItems, Mode=OneWay}"
            FrameMargin="0"
            IsBackButtonVisible="Visible"
            IsPaneToggleVisible="True"
            MenuItemsSource="{Binding ViewModel.MenuItems, Mode=OneWay}"
            PaneDisplayMode="LeftFluent">
            <ui:NavigationView.Header>
                <ui:BreadcrumbBar x:Name="BreadcrumbBar" Margin="42,32,42,20" />
            </ui:NavigationView.Header>
            <ui:NavigationView.ContentOverlay>
                <Grid RowDefinitions="*">
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                    <ContentControl
                        x:Name="PlayerHost"
                        MaxHeight="250"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        <ContentPresenter
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="2" />
        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ViewModel.ApplicationTitle}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Border
            Grid.Row="2"
            Height="90"
            Margin="8"
            Padding="12"
            BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Cover  -->
                <Border
                    Width="58"
                    Height="58"
                    ClipToBounds="True"
                    CornerRadius="12">

                    <Image Source="{Binding ViewModel.Thumbnail, TargetNullValue={x:Null}}" Stretch="Uniform" />
                </Border>
                <Grid
                    Grid.Column="1"
                    Margin="16,0"
                    RowDefinitions="Auto,*">
                    <!--  Song Info  -->
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding ViewModel.Title}" />

                        <ui:TextBlock
                            Margin="0,2,0,0"
                            Opacity="0.7"
                            Text="{Binding ViewModel.Uploader}" />


                    </StackPanel>
                    <Grid
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        ColumnDefinitions="Auto,*,Auto">
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="{Binding ViewModel.ProgressText}" />

                        <Slider
                            x:Name="ProgressSlider"
                            Grid.Column="1"
                            Maximum="{Binding ViewModel.Duration}"
                            PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"
                            Value="{Binding ViewModel.Progress, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="{Binding ViewModel.DurationText}" />

                    </Grid>
                </Grid>


                <!--  Controls  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <ui:Button
                        Margin="4"
                        Appearance="Transparent"
                        Command="{Binding ViewModel.Rewind10SecondsCommand}"
                        Icon="{ui:SymbolIcon Symbol=SkipBack1024}" />

                    <ui:Button
                        Margin="4"
                        Appearance="Primary"
                        Command="{Binding ViewModel.PlayPauseCommand}">

                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="{Binding ViewModel.PlayPauseIcon}" />
                        </ui:Button.Icon>

                    </ui:Button>

                    <ui:Button
                        Margin="4"
                        Appearance="Transparent"
                        Command="{Binding ViewModel.Skip10SecondsCommand}"
                        Icon="{ui:SymbolIcon Symbol=SkipForward1024}" />
                    <ui:Button
                        Margin="4"
                        Appearance="Transparent"
                        Command="{Binding ViewModel.OpenFloatingWindowCommand}"
                        Icon="{ui:SymbolIcon Symbol=PictureInPicture24}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
